SHOPIFY_SHOP=your-store.myshopify.com
# Option A: Dev Dashboard app (client credentials)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Option B: a static Admin API token (shpat_...) - leave A empty if you use this
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10
# Long random secret protecting the MCP endpoint (>= 24 chars). Generate: openssl rand -hex 32
MCP_AUTH_TOKEN=
READ_ONLY=false
MAX_RESPONSE_CHARS=80000
